{
  "name": "strand",
  "productName": "Strand",
  "version": "0.1.25",
  "description": "One player for Spotify, Apple Music, YouTube Music and SoundCloud — synced lyrics, visualizer, playlist import.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder",
    "test": "node tests/e2e.js && node tests/accounts.js && node tests/desktop-signin.js && node tests/mobile.js && node tests/preview-fallback.js && node tests/local-music.js && node tests/itunes.js && node tests/cloud-music.js && node tests/youtube-first.js"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.0.12",
    "playwright": "^1.48.0"
  },
  "build": {
    "appId": "app.strand.player",
    "productName": "Strand",
    "files": [
      "electron/**",
      "public/**",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kat-heu",
        "repo": "strand",
        "releaseType": "draft"
      }
    ],
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "afterPack": "scripts/vmp-sign.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kat-heu/strand.git"
  },
  "author": "kat-heu",
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
